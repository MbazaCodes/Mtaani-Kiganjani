# ─────────────────────────────────────────────────────────────────────────────
# E-MTAA / Mtaani-Kiganjani — Environment Variables Template
# Copy this file to .env.local (development) or set in Vercel dashboard (production)
# NEVER commit .env.local or any file with real secrets to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL — recommended):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/emtaa?schema=public&sslmode=require"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: NEXT_PUBLIC_APP_URL="https://e-mtaatz.xyz"

NEXT_PUBLIC_APP_NAME="E-MTAA"
NEXT_PUBLIC_APP_ENV="development"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://e-mtaatz.xyz"

# Token expiry in days (default: 7)
AUTH_TOKEN_EXPIRY_DAYS="7"

# ── SMS — Beem Africa (https://beem.africa) ───────────────────────────────────
ENABLE_SMS="false"
SMS_PROVIDER="beem"
BEEM_API_KEY=""
BEEM_SECRET_KEY=""
BEEM_SENDER_ID="E-MTAA"

# Alternative: Africa's Talking
# SMS_PROVIDER="africastalking"
# AT_USERNAME=""
# AT_API_KEY=""

# ── Email ─────────────────────────────────────────────────────────────────────
ENABLE_EMAIL="false"
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="noreply@e-mtaatz.xyz"
EMAIL_FROM_NAME="E-MTAA — Huduma za Serikali"

# ── NIDA Integration ─────────────────────────────────────────────────────────
# Requires formal agreement with NIDA Tanzania
ENABLE_NIDA="false"
NIDA_API_URL=""
NIDA_API_KEY=""
# IMPORTANT: NIDA_API_KEY must be server-side only — never prefix with NEXT_PUBLIC_

# ── GePG Payment Gateway ──────────────────────────────────────────────────────
# Tanzania Government e-Payment Gateway
ENABLE_PAYMENTS="false"
PAYMENT_PROVIDER="gepg"
GEPG_MERCHANT_ID=""
GEPG_SECRET_KEY=""
GEPG_API_URL=""
GEPG_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/payments/callback"

# ── TRA — Tanzania Revenue Authority ──────────────────────────────────────────
ENABLE_TRA="false"
TRA_API_URL=""
TRA_CLIENT_ID=""
TRA_CLIENT_SECRET=""

# ── File Storage ──────────────────────────────────────────────────────────────
# Development: local filesystem
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="10"

# Production: Cloudinary or AWS S3
# STORAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Per-IP login attempts before lockout
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MS="60000"
# Per-IP registration attempts
RATE_LIMIT_REGISTER_MAX="3"
RATE_LIMIT_REGISTER_WINDOW_MS="300000"

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_NOTIFICATIONS_POLLING="true"
FEATURE_PWA="true"
FEATURE_ANALYTICS="false"
FEATURE_QR_VERIFICATION="true"
FEATURE_COMMUNITY_REPORTING="false"
