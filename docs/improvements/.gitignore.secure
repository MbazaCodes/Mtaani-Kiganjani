# ─────────────────────────────────────────────────────────────────────────────
# E-MTAA / Mtaani-Kiganjani — .gitignore (AUDITED)
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
.vercel

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Environment files — NEVER COMMIT THESE ───────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Database files — NEVER COMMIT THESE ─────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/*.db
prisma/dev.db
prisma/test.db

# ── Secrets / Keys ───────────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ── Uploads / User data ───────────────────────────────────────────────────────
public/uploads/
uploads/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
dev.log
server.log

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/settings.json
.idea/

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Android (Capacitor) ───────────────────────────────────────────────────────
android/app/release/
android/.gradle/
android/app/build/
*.keystore
*.jks

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
tmp/
temp/
