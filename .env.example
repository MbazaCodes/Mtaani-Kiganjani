# ─────────────────────────────────────────────────────────────────────────────
# E-MTAA Environment Variables
# Copy to .env for local dev: cp .env.example .env
# Set secrets in Vercel / Supabase project settings. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# CLIENT-SIDE
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Explicit demo boundary. Production MUST be false.
VITE_DEMO_MODE=false

# Optional local Express adapter for development only.
VITE_USE_LOCAL_SERVER=false
VITE_LOCAL_SERVER_URL=http://localhost:3001

# SERVER-SIDE ONLY — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
